            activePhraseCategory = cat;
            document.querySelectorAll('.pcat-btn').forEach(btn => {
                if (btn.dataset.pcat === cat) {
                    btn.className = "pcat-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-terracotta-700 text-white";
                } else {
                    btn.className = "pcat-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-marble-100 text-stone-700 hover:bg-marble-200";
                }
            });
            renderGuidingPhrases();
        }

        function renderGuidingPhrases() {
            const container = document.getElementById('phrasesListContainer');
            container.innerHTML = guidingPhrasesData.map((item, idx) => {
                if (activePhraseCategory !== 'all' && item.cat !== activePhraseCategory) return '';
                return `
                <div id="phrase-card-${idx}" class="bg-white rounded-2xl p-5 sm:p-6 border border-marble-200 shadow-sm hover:border-domegold-400 transition flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                    <div class="space-y-2 flex-1">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="px-2.5 py-0.5 rounded-md bg-marble-200 text-stone-700 text-xs font-extrabold">#${idx + 1}</span>
                            <span class="px-3 py-0.5 rounded-full bg-terracotta-700/10 text-terracotta-800 text-xs font-bold">
                                ${item.catTr} (<span lang="en">${item.catEn}</span>)
                            </span>
                        </div>
                        <p class="text-base sm:text-lg font-extrabold text-slatebyz-900 leading-snug" lang="en">
                            "${item.en}"
                        </p>
                        <div class="text-xs sm:text-sm bg-amber-50 text-amber-950 border border-amber-200 px-3 py-1.5 rounded-xl inline-block">
                            🗣️ <strong>Okunuşu:</strong> ${item.okunus}
                        </div>
                        <p class="text-sm font-semibold text-stone-700">
                            🇹🇷 ${item.tr}
                        </p>
                        <div class="text-xs text-stone-600 bg-marble-50 border border-marble-200 px-3 py-2 rounded-xl flex items-start gap-2">
                            <i class="fa-solid fa-lightbulb text-domegold-500 mt-0.5"></i>
                            <span><strong>Rehber İpucu:</strong> ${item.tip}</span>
                        </div>
                    </div>

                    <div class="flex lg:flex-col items-center gap-2 shrink-0">
                        <button onclick="speakPhraseByIndex(${idx})" class="flex-1 lg:w-36 px-4 py-2.5 rounded-xl bg-terracotta-700 hover:bg-terracotta-800 text-white text-xs sm:text-sm font-bold shadow-sm transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-volume-high"></i> Dinle
                        </button>
                        <button onclick="copyPhraseByIndex(${idx})" class="px-4 py-2 rounded-xl bg-marble-100 hover:bg-marble-200 text-stone-700 border border-marble-300 text-xs font-bold transition flex items-center justify-center gap-1.5 lg:w-36">
                            <i class="fa-regular fa-copy"></i> Kopyala
                        </button>
                    </div>
                </div>
                `;
            }).join('');
        }

        // =====================================================
        // RENDER SECTION 3: READING PASSAGE + COMPREHENSION
        // =====================================================
        function renderReadingSection() {
            const box = document.getElementById('readingParagraphsBox');
            box.innerHTML = readingParagraphs.map((p, idx) => `
                <div id="reading-para-${idx}" class="p-5 rounded-2xl bg-marble-50 border border-marble-200 space-y-3 transition">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <h3 class="font-display font-bold text-base sm:text-lg text-terracotta-800" lang="en">${p.heading}</h3>
                        <button onclick="speakReadingParagraph(${idx})" class="px-3.5 py-1.5 rounded-xl bg-white hover:bg-amber-50 text-terracotta-800 border border-marble-300 text-xs font-extrabold shadow-sm transition flex items-center gap-1.5">
                            <i class="fa-solid fa-volume-high text-domegold-500"></i> Paragrafı Dinle
                        </button>
                    </div>
                    <p class="text-sm sm:text-base text-stone-900 leading-relaxed" lang="en">${p.htmlEn}</p>
                    <div class="reading-pron-box ${showReadingPron ? '' : 'hidden'} p-3 rounded-xl bg-amber-50/90 border border-amber-200 text-xs text-amber-950 leading-relaxed">
                        🗣️ <strong>Okunuş Rehberi:</strong> ${p.okunus}
                    </div>
                    <div class="reading-tr-box ${showReadingTr ? '' : 'hidden'} p-3 rounded-xl bg-white border border-marble-200 text-xs sm:text-sm text-stone-700 leading-relaxed">
                        🇹🇷 <strong>Türkçe Çeviri:</strong> ${p.tr}
                    </div>
                </div>
            `).join('');

            const compGrid = document.getElementById('readingCompGrid');
            compGrid.innerHTML = readingCompData.map((item, qIdx) => `
                <div class="p-4 sm:p-5 rounded-2xl bg-marble-50 border border-marble-200 space-y-3">
                    <p class="text-sm font-extrabold text-slatebyz-900" lang="en">${item.q}</p>
                    <div class="space-y-2">
                        ${item.options.map((opt, oIdx) => `
                            <button id="rcomp-${qIdx}-${oIdx}" onclick="checkReadingComp(${qIdx}, ${oIdx})"
                                class="w-full text-left px-3.5 py-2.5 rounded-xl bg-white hover:bg-amber-50 border border-marble-300 text-xs sm:text-sm font-medium transition" lang="en">
                                ${opt}
                            </button>
                        `).join('')}
                    </div>
                    <div id="rcomp-fb-${qIdx}" class="hidden p-3 rounded-xl text-xs font-semibold"></div>
                </div>
            `).join('');
        }

        function speakReadingParagraph(idx) {
            const p = readingParagraphs[idx];
            if (!p) return;
            speakEnglish(p.rawEn, {
                cardId: `reading-para-${idx}`,
                statusLabel: `Okuma Parçası — Paragraf ${p.num}/5`
            });
        }

        function togglePlayAllReading() {
            if (isSequencePlaying && sequenceMode === 'reading') {
                stopSpeech();
                return;
            }
            isSequencePlaying = true;
            sequenceMode = 'reading';
            sequenceCursor = 0;
            document.getElementById('playAllReadingBtn').innerHTML = `<i class="fa-solid fa-stop"></i> Okumayı Durdur`;
            runNextReadingParagraph();
        }

        function runNextReadingParagraph() {
            if (!isSequencePlaying || sequenceCursor >= readingParagraphs.length) {
                stopSpeech();
                return;
            }
            const p = readingParagraphs[sequenceCursor];
            speakEnglish(p.rawEn, {
                keepSequence: true,
                cardId: `reading-para-${sequenceCursor}`,
                scroll: true,
                statusLabel: `Tüm Metin Okunuyor (${p.num}/5)`,
                onDone: () => {
                    sequenceCursor++;
                    runNextReadingParagraph();
                }
            });
        }

        function toggleReadingPronunciation() {
            showReadingPron = !showReadingPron;
            document.getElementById('toggleReadingPronBtn').textContent = showReadingPron
                ? '🗣️ Okunuş Rehberini Gizle'
                : '🗣️ Okunuş Rehberini Göster';
            document.querySelectorAll('.reading-pron-box').forEach(el => el.classList.toggle('hidden', !showReadingPron));
        }

        function toggleReadingTranslations() {
            showReadingTr = !showReadingTr;
            document.getElementById('toggleReadingTransBtn').textContent = showReadingTr
                ? '🇹🇷 Türkçe Çeviriyi Gizle'
                : '🇹🇷 Türkçe Çeviriyi Göster';
            document.querySelectorAll('.reading-tr-box').forEach(el => el.classList.toggle('hidden', !showReadingTr));
        }

        function openInlineVocab(vocabId) {
            const item = vocabularyData.find(v => v.id === vocabId);
            if (!item) return;
            const popup = document.getElementById('inlineVocabPopup');
            document.getElementById('popupVocabWord').textContent = item.word;
            document.getElementById('popupVocabPron').textContent = `${item.ipa} • Okunuşu: ${item.okunus}`;
            document.getElementById('popupVocabMeaning').textContent = `🇹🇷 ${item.tr}`;
            document.getElementById('popupVocabSpeakBtn').onclick = () => speakEnglish(item.word, { statusLabel: `Kelime: ${item.word}` });
            popup.classList.remove('hidden');
            speakEnglish(item.word, { statusLabel: `Kelime: ${item.word}` });
        }

        function checkReadingComp(qIdx, oIdx) {
            const q = readingCompData[qIdx];
            const fb = document.getElementById(`rcomp-fb-${qIdx}`);
            fb.classList.remove('hidden');

            q.options.forEach((_, idx) => {
                const b = document.getElementById(`rcomp-${qIdx}-${idx}`);
                b.classList.remove('bg-emerald-100', 'border-emerald-500', 'bg-red-100', 'border-red-400');
            });

            const target = document.getElementById(`rcomp-${qIdx}-${oIdx}`);
            if (oIdx === q.correct) {
                target.classList.add('bg-emerald-100', 'border-emerald-500');
                fb.className = "p-3 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-900 border border-emerald-200";
                fb.innerHTML = `✅ ${q.explanation}`;
            } else {
                target.classList.add('bg-red-100', 'border-red-400');
                fb.className = "p-3 rounded-xl text-xs font-semibold bg-red-50 text-red-900 border border-red-200";
                fb.innerHTML = `❌ Tekrar deneyin! ${q.explanation}`;
            }
        }

        // =====================================================
        // RENDER SECTION 4: 14-LINE GUIDED TOUR DIALOGUE
        // =====================================================
        function renderDialogueSection() {
            const box = document.getElementById('dialogueLinesContainer');
            box.innerHTML = dialogueData.map((line, idx) => {
                const isGuide = line.role === 'guide';
                const badgeStyle = isGuide
                    ? 'bg-terracotta-700 text-white'
                    : (line.role === 'sarah' ? 'bg-sky-700 text-white' : 'bg-emerald-700 text-white');
                const cardStyle = isGuide
                    ? 'bg-amber-50/40 border-domegold-400/70'
                    : 'bg-white border-marble-200 sm:ml-8';
                const flag = isGuide ? '🚩' : (line.role === 'sarah' ? '🇬🇧' : '🇮🇹');

                return `
                <div id="diag-card-${idx}" class="rounded-2xl p-4 sm:p-5 border ${cardStyle} shadow-sm transition flex items-start justify-between gap-3">
                    <div class="space-y-2 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="px-3 py-0.5 rounded-full text-xs font-bold ${badgeStyle}" lang="en">${flag} ${line.speaker}</span>
                            <span class="text-xs font-bold text-stone-400">#${idx + 1}</span>
                        </div>
                        <p class="text-sm sm:text-base font-semibold text-slatebyz-900 leading-relaxed" lang="en">
                            "${line.en}"
                        </p>
                        <div class="diag-pron-box ${showDialoguePron ? '' : 'hidden'} text-xs bg-amber-100/70 text-amber-950 px-3 py-1.5 rounded-xl">
                            🗣️ <strong>Okunuşu:</strong> ${line.okunus}
                        </div>
                        <p class="diag-tr-box ${showDialogueTr ? '' : 'hidden'} text-xs sm:text-sm text-stone-600 pt-1.5 border-t border-marble-200">
                            🇹🇷 ${line.tr}
                        </p>
                    </div>
                    <button onclick="speakDialogueLine(${idx})" class="shrink-0 w-10 h-10 rounded-xl bg-terracotta-700 hover:bg-terracotta-800 text-white flex items-center justify-center shadow-sm transition" title="Bu repliği dinle">
                        <i class="fa-solid fa-volume-high"></i>
                    </button>
                </div>
                `;
            }).join('');
        }

        function speakDialogueLine(idx) {
            const line = dialogueData[idx];
            if (!line) return;
            speakEnglish(line.en, {
                pitch: line.pitch,
                cardId: `diag-card-${idx}`,
                statusLabel: `${line.speaker} (#${idx + 1}/14)`
            });
        }

        function togglePlayFullDialogue() {
            if (isSequencePlaying && sequenceMode === 'dialogue') {
                stopSpeech();
                return;
            }
            isSequencePlaying = true;
            sequenceMode = 'dialogue';
            sequenceCursor = 0;
            document.getElementById('playFullDialogueBtn').innerHTML = `<i class="fa-solid fa-stop"></i> Diyaloğu Durdur`;
            runNextDialogueLine();
        }

        function runNextDialogueLine() {
            if (!isSequencePlaying || sequenceCursor >= dialogueData.length) {
                stopSpeech();
                return;
            }
            const line = dialogueData[sequenceCursor];
            speakEnglish(line.en, {
                keepSequence: true,
                pitch: line.pitch,
                cardId: `diag-card-${sequenceCursor}`,
                scroll: true,
                statusLabel: `Diyalog (${sequenceCursor + 1}/14) — ${line.speaker}`,
                onDone: () => {
                    sequenceCursor++;
                    runNextDialogueLine();
                }
            });
        }

        function toggleDialoguePron() {
            showDialoguePron = !showDialoguePron;
            document.getElementById('toggleDiagPronBtn').textContent = showDialoguePron
                ? '🗣️ Okunuşları Gizle'
                : '🗣️ Okunuşları Göster';
            document.querySelectorAll('.diag-pron-box').forEach(el => el.classList.toggle('hidden', !showDialoguePron));
        }

        function toggleDialogueTrans() {
            showDialogueTr = !showDialogueTr;
            document.getElementById('toggleDiagTransBtn').textContent = showDialogueTr
                ? '🇹🇷 Çeviriyi Gizle'
                : '🇹🇷 Çeviriyi Göster';
            document.querySelectorAll('.diag-tr-box').forEach(el => el.classList.toggle('hidden', !showDialogueTr));
        }

        // =====================================================
        // RENDER SECTION 5: 8 INTERESTING FACTS
        // =====================================================
        function renderFactsSection() {
            const grid = document.getElementById('factsCardsGrid');
            grid.innerHTML = interestingFactsData.map((fact, idx) => `
                <div id="fact-card-${idx}" class="bg-white rounded-2xl p-5 sm:p-6 border border-marble-200 shadow-sm hover:shadow-md transition flex flex-col justify-between space-y-4">
                    <div class="space-y-3">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex items-center gap-3">
                                <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-terracotta-700 to-slatebyz-900 text-domegold-400 flex items-center justify-center text-lg shadow-sm shrink-0">
                                    <i class="fa-solid ${fact.icon}"></i>
                                </div>
                                <div>
                                    <span class="text-xs font-extrabold text-domegold-600" lang="en">FACT #${fact.num}</span>
                                    <h3 class="font-display text-base sm:text-lg font-bold text-slatebyz-900 leading-snug" lang="en">${fact.title}</h3>
                                </div>
                            </div>
                            <button onclick="speakFactByIndex(${idx})" class="shrink-0 px-3.5 py-2 rounded-xl bg-terracotta-700 hover:bg-terracotta-800 text-white text-xs font-bold shadow-sm transition flex items-center gap-1.5" lang="en">
                                <i class="fa-solid fa-volume-high"></i> Play
                            </button>
                        </div>

                        <p class="text-sm text-stone-800 leading-relaxed font-medium" lang="en">${fact.en}</p>

                        <div class="fact-pron-box ${showFactsPronAll ? '' : 'hidden'} p-3 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-950 leading-relaxed">
                            🗣️ <strong>Okunuşu:</strong> ${fact.okunus}
                        </div>
                    </div>

                    <div class="pt-3 border-t border-marble-200 text-xs text-stone-600 leading-relaxed bg-marble-50 p-3 rounded-xl">
                        🇹🇷 <strong>Türkçe Özeti:</strong> ${fact.tr}
                    </div>
                </div>
            `).join('');
        }

        function speakFactByIndex(idx) {
            const f = interestingFactsData[idx];
            if (!f) return;
            speakEnglish(`${f.title}. ${f.en}`, {
                cardId: `fact-card-${idx}`,
                statusLabel: `Fact #${f.num}: ${f.title}`
            });
        }

        function toggleAllFactsPron() {
            showFactsPronAll = !showFactsPronAll;
            document.querySelectorAll('.fact-pron-box').forEach(el => el.classList.toggle('hidden', !showFactsPronAll));
        }

        // =====================================================
        // RENDER SECTION 6: 10-QUESTION INTERACTIVE MINI QUIZ
        // =====================================================
        function renderQuizSection() {
            document.getElementById('quizScoreCount').textContent = quizScore;
            const list = document.getElementById('quizQuestionsList');
            list.innerHTML = quizData.map((item, qIdx) => `
                <div class="bg-white rounded-2xl p-5 sm:p-6 border border-marble-200 shadow-sm space-y-3.5">
                    <p class="font-extrabold text-sm sm:text-base text-slatebyz-900">${item.q}</p>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                        ${item.options.map((opt, oIdx) => `
                            <button id="qopt-${qIdx}-${oIdx}" onclick="selectQuizOption(${qIdx}, ${oIdx})"
                                class="text-left px-4 py-3 rounded-xl border border-marble-300 bg-marble-50 hover:bg-amber-50 text-xs sm:text-sm font-semibold transition" lang="en">
                                ${opt}
                            </button>
                        `).join('')}
                    </div>
                    <div id="qfb-${qIdx}" class="hidden p-3.5 rounded-xl text-xs sm:text-sm space-y-1"></div>
                </div>
            `).join('');
        }

        function selectQuizOption(qIdx, selectedIdx) {
            if (quizAnswers[qIdx] !== undefined) return;
            quizAnswers[qIdx] = selectedIdx;

            const item = quizData[qIdx];
            const fb = document.getElementById(`qfb-${qIdx}`);
            fb.classList.remove('hidden');

            item.options.forEach((_, i) => {
                const btn = document.getElementById(`qopt-${qIdx}-${i}`);
                btn.disabled = true;
                if (i === item.correct) {
                    btn.className = "text-left px-4 py-3 rounded-xl border-2 border-emerald-500 bg-emerald-50 text-emerald-950 text-xs sm:text-sm font-extrabold";
                } else if (i === selectedIdx) {
                    btn.className = "text-left px-4 py-3 rounded-xl border-2 border-red-400 bg-red-50 text-red-900 text-xs sm:text-sm font-semibold";
                } else {
                    btn.classList.add('opacity-60');
                }
            });

            if (selectedIdx === item.correct) {
                quizScore++;
                document.getElementById('quizScoreCount').textContent = quizScore;
                fb.className = "p-3.5 rounded-xl text-xs sm:text-sm bg-emerald-50 text-emerald-950 border border-emerald-200 space-y-1";
                fb.innerHTML = `<div>✅ <strong>${item.expTr}</strong></div><div class="text-emerald-800" lang="en">💡 ${item.expEn}</div>`;
            } else {
                fb.className = "p-3.5 rounded-xl text-xs sm:text-sm bg-red-50 text-red-950 border border-red-200 space-y-1";
                fb.innerHTML = `<div>❌ <strong>Yanlış seçim.</strong> ${item.expTr}</div><div class="text-red-800" lang="en">💡 ${item.expEn}</div>`;
            }

            if (Object.keys(quizAnswers).length === quizData.length) {
                showToast(`Tebrikler, testi tamamladınız! Skorunuz: ${quizScore} / 10`);
            }
        }

        function resetQuizAll() {
            quizAnswers = {};
            quizScore = 0;
            renderQuizSection();
            showToast("Mini test sıfırlandı!");
        }

        // =====================================================
        // INITIALIZE ON WINDOW LOAD
        // =====================================================
        window.onload = function () {
            renderVocabulary();
            renderGuidingPhrases();
            renderReadingSection();
            renderDialogueSection();
            renderFactsSection();
            renderQuizSection();
        };
    </script>
</body>
</html>
