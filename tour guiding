        function stopSpeech() {
            isSequencePlaying = false;
            sequenceMode = null;
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
            }
            setGlobalAudioStatus(false);
        }

        function speakEnglish(text, opts = {}) {
            if (!('speechSynthesis' in window)) {
                showToast("Tarayıcınız ses sentezlemeyi desteklemiyor.");
                return;
            }

            if (!opts.keepSequence) {
                isSequencePlaying = false;
                sequenceMode = null;
                resetSequenceButtonsUI();
            }

            window.speechSynthesis.cancel();
            document.querySelectorAll('.active-speaking').forEach(el => el.classList.remove('active-speaking'));

            setTimeout(() => {
                const utter = new SpeechSynthesisUtterance(text);
                window.activeUtteranceRef = utter;

                if (!englishVoice) selectBestEnglishVoice();
                if (englishVoice) utter.voice = englishVoice;
                utter.lang = (englishVoice && englishVoice.lang) ? englishVoice.lang : 'en-US';
                utter.rate = currentSpeechRate;
                utter.pitch = opts.pitch || 1.0;

                if (opts.cardId) {
                    const el = document.getElementById(opts.cardId);
                    if (el) {
                        el.classList.add('active-speaking');
                        if (opts.scroll) {
                            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }
                    }
                }

                utter.onstart = () => {
                    setGlobalAudioStatus(true, opts.statusLabel || `Seslendiriliyor: "${text.slice(0, 48)}${text.length > 48 ? '...' : ''}"`);
                };

                utter.onend = () => {
                    if (opts.onDone && isSequencePlaying) {
                        opts.onDone();
                    } else {
                        setGlobalAudioStatus(false);
                    }
                };

                utter.onerror = () => {
                    setGlobalAudioStatus(false);
                };

                window.speechSynthesis.speak(utter);
            }, 40);
        }

