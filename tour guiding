<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hagia Sophia (Ayasofya) - Turist Rehberliği İngilizce Modülü</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Cinzel & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        display: ['Cinzel', 'serif'],
                    },
                    colors: {
                        marble: {
                            50: '#FDFBF7',
                            100: '#F7F2E7',
                            200: '#ECE2CE',
                            300: '#DDD0B4'
                        },
                        terracotta: {
                            600: '#B84A39',
                            700: '#9A382A',
                            800: '#7C2B20',
                            900: '#591D15'
                        },
                        slatebyz: {
                            800: '#1E293B',
                            900: '#0F172A'
                        },
                        domegold: {
                            400: '#E7B94B',
                            500: '#CE9B2C',
                            600: '#A87B1B'
                        }
                    }
                }
            }
        };
    </script>

    <style>
        /* NOTE: text-transform: uppercase is intentionally NEVER used so Turkish browsers never turn English 'i' into 'İ' */
        body {
            background-color: #FDFBF7;
            background-image: radial-gradient(#E5D9C3 0.8px, transparent 0.8px);
            background-size: 24px 24px;
        }
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #F7F2E7;
        }
        ::-webkit-scrollbar-thumb {
            background: #CE9B2C;
            border-radius: 9999px;
        }
        .active-speaking {
            box-shadow: 0 0 0 3px rgba(206, 155, 44, 0.65);
            background-color: #FFFBEB !important;
            transition: all 0.25s ease;
        }
        .vocab-inline {
            border-bottom: 2px dashed #CE9B2C;
            color: #9A382A;
            font-weight: 700;
            cursor: pointer;
            padding: 0 3px;
            border-radius: 4px;
            transition: background-color 0.2s ease;
        }
        .vocab-inline:hover {
            background-color: #FEF3C7;
        }
        @keyframes eqPulse {
            0%, 100% { transform: scaleY(0.45); }
            50% { transform: scaleY(1.15); }
        }
        .eq-bar {
            animation: eqPulse 0.75s infinite ease-in-out;
        }
        .eq-bar:nth-child(2) { animation-delay: 0.15s; }
        .eq-bar:nth-child(3) { animation-delay: 0.3s; }
    </style>
</head>
<body class="font-sans text-stone-800 antialiased min-h-screen flex flex-col">

    <!-- =====================================================
         GLOBAL STICKY AUDIO CONTROL BAR (TOP)
         ===================================================== -->
    <div class="sticky top-0 z-40 bg-slatebyz-900 text-marble-50 border-b-2 border-domegold-500 shadow-md">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-2.5 flex flex-wrap items-center justify-between gap-3">
            <!-- Currently Playing Status Indicator -->
            <div class="flex items-center gap-2.5 min-w-0">
                <div id="audioWaveIcon" class="hidden items-end gap-0.5 h-4 shrink-0">
                    <span class="w-1 h-3 bg-domegold-400 rounded eq-bar"></span>
                    <span class="w-1 h-4 bg-domegold-400 rounded eq-bar"></span>
                    <span class="w-1 h-2.5 bg-domegold-400 rounded eq-bar"></span>
                </div>
                <i id="audioIdleIcon" class="fa-solid fa-headphones text-domegold-400 text-sm shrink-0"></i>
                <span id="audioStatusLabel" class="text-xs sm:text-sm font-medium text-marble-100 truncate max-w-[220px] sm:max-w-md">
                    Sesli Rehber Hazır — Dinlemek için hoparlör butonlarına tıklayın
                </span>
            </div>

            <!-- Speed Toggle & Stop Button -->
            <div class="flex items-center gap-2 flex-wrap">
                <span class="text-xs text-stone-300 hidden sm:inline">Okuma Hızı:</span>
                <div class="inline-flex rounded-xl bg-slatebyz-800 p-0.5 border border-stone-700" lang="en">
                    <button id="rateBtn-0.8" onclick="setSpeechRate(0.8)" class="px-2.5 py-1 rounded-lg text-xs font-semibold transition text-stone-300 hover:text-white">
                        Slow (0.8x)
                    </button>
                    <button id="rateBtn-1" onclick="setSpeechRate(1.0)" class="px-2.5 py-1 rounded-lg text-xs font-semibold transition bg-domegold-500 text-stone-950 shadow-sm">
                        Normal (1.0x)
                    </button>
                    <button id="rateBtn-1.15" onclick="setSpeechRate(1.15)" class="px-2.5 py-1 rounded-lg text-xs font-semibold transition text-stone-300 hover:text-white">
                        Fast (1.15x)
                    </button>
                </div>
                <button id="stopAudioBtn" onclick="stopSpeech()" class="px-3 py-1.5 rounded-xl bg-red-600 hover:bg-red-500 text-white text-xs font-bold transition flex items-center gap-1.5 shadow-sm">
                    <i class="fa-solid fa-stop"></i> Sesi Durdur
                </button>
            </div>
        </div>
    </div>

    <!-- =====================================================
         HERO HEADER
         ===================================================== -->
    <header class="bg-gradient-to-br from-terracotta-900 via-terracotta-800 to-slatebyz-900 text-marble-50 relative overflow-hidden border-b-4 border-domegold-500">
        <!-- Architectural Dome & Minarets SVG Silhouette -->
        <div class="absolute right-0 bottom-0 opacity-10 pointer-events-none">
            <svg width="420" height="180" viewBox="0 0 420 180" fill="currentColor">
                <path d="M210 28 C135 28 100 84 100 115 L65 115 L65 180 L355 180 L355 115 L320 115 C320 84 285 28 210 28 Z"/>
                <rect x="28" y="12" width="12" height="168"/>
                <polygon points="34,0 25,16 43,16"/>
                <rect x="380" y="12" width="12" height="168"/>
                <polygon points="386,0 377,16 395,16"/>
            </svg>
        </div>

        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-7 sm:py-9 relative z-10">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
                <div class="space-y-2.5">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-domegold-500/20 border border-domegold-400/50 text-domegold-400 text-xs font-bold tracking-wide" lang="en">
                        <i class="fa-solid fa-compass"></i> TOURIST GUIDING ENGLISH • LEVEL: PRE-INTERMEDIATE / INTERMEDIATE (A2–B1+)
                    </div>
                    <h1 class="font-display text-2xl sm:text-4xl font-extrabold text-white tracking-wide leading-tight" lang="en">
                        HAGIA SOPHIA <span class="text-domegold-400 font-semibold text-xl sm:text-2xl">(Ayasofya)</span>
                    </h1>
                    <p class="text-marble-200 text-sm sm:text-base max-w-3xl leading-relaxed">
                        Turist rehberliği öğrencileri için özel olarak hazırlanan kapsamlı eğitim kaynağı: <strong>35 mesleki kelime</strong>, <strong>18 rehberlik kalıbı</strong>, <strong>5 paragraflık okuma parçası</strong>, <strong>14 repliklik canlı tur diyaloğu</strong>, <strong lang="en">8 Interesting Facts</strong> ve <strong>10 soruluk mini test</strong>. Her bölümde sesli İngilizce telaffuz, IPA ve Türkçe okunuş rehberi yer alır.
                    </p>
                </div>

                <!-- Quick Stats Cards -->
                <div class="grid grid-cols-3 gap-2.5 shrink-0">
                    <div class="bg-slatebyz-900/60 backdrop-blur-sm border border-domegold-500/30 rounded-2xl p-3 text-center">
                        <div class="text-xl sm:text-2xl font-extrabold text-domegold-400">35</div>
                        <div class="text-[11px] text-marble-200 font-medium">Kelime + Ses</div>
                    </div>
                    <div class="bg-slatebyz-900/60 backdrop-blur-sm border border-domegold-500/30 rounded-2xl p-3 text-center">
                        <div class="text-xl sm:text-2xl font-extrabold text-domegold-400">18</div>
                        <div class="text-[11px] text-marble-200 font-medium">Tur Kalıbı</div>
                    </div>
                    <div class="bg-slatebyz-900/60 backdrop-blur-sm border border-domegold-500/30 rounded-2xl p-3 text-center">
                        <div class="text-xl sm:text-2xl font-extrabold text-domegold-400">100%</div>
                        <div class="text-[11px] text-marble-200 font-medium">Okunuş Rehberi</div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- =====================================================
         MAIN NAVIGATION TABS (6 RICH SECTIONS)
         ===================================================== -->
    <nav class="bg-marble-100 border-b border-marble-300 shadow-sm sticky top-[46px] sm:top-[48px] z-30">
        <div class="max-w-6xl mx-auto px-2 sm:px-6">
            <div class="flex items-center gap-1.5 sm:gap-2 overflow-x-auto py-2.5">
                <button onclick="switchTab('vocab')" data-tab="vocab" class="tab-btn shrink-0 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition flex items-center gap-2 bg-terracotta-700 text-white shadow-sm">
                    <i class="fa-solid fa-book-bookmark"></i>
                    <span>1. Kelimeler (35)</span>
                </button>
                <button onclick="switchTab('phrases')" data-tab="phrases" class="tab-btn shrink-0 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition flex items-center gap-2 text-stone-700 hover:bg-marble-200">
                    <i class="fa-solid fa-bullhorn"></i>
                    <span>2. Rehberlik Kalıpları (18)</span>
                </button>
                <button onclick="switchTab('reading')" data-tab="reading" class="tab-btn shrink-0 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition flex items-center gap-2 text-stone-700 hover:bg-marble-200">
                    <i class="fa-solid fa-feather-pointed"></i>
                    <span>3. Okuma Parçası</span>
                </button>
                <button onclick="switchTab('dialogue')" data-tab="dialogue" class="tab-btn shrink-0 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition flex items-center gap-2 text-stone-700 hover:bg-marble-200">
                    <i class="fa-solid fa-comments"></i>
                    <span>4. Turist-Rehber Diyaloğu (14)</span>
                </button>
                <button onclick="switchTab('facts')" data-tab="facts" class="tab-btn shrink-0 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition flex items-center gap-2 text-stone-700 hover:bg-marble-200">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    <span lang="en">5. Interesting Facts (8)</span>
                </button>
                <button onclick="switchTab('quiz')" data-tab="quiz" class="tab-btn shrink-0 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition flex items-center gap-2 text-stone-700 hover:bg-marble-200">
                    <i class="fa-solid fa-trophy"></i>
                    <span>6. Mini Test (10 Soru)</span>
                </button>
            </div>
        </div>
    </nav>

    <!-- NON-BLOCKING TOAST NOTIFICATION -->
    <div id="toastBanner" class="fixed bottom-5 right-5 z-50 hidden items-center gap-2.5 bg-slatebyz-900 text-marble-50 border-l-4 border-domegold-400 px-4 py-3 rounded-xl shadow-2xl text-xs sm:text-sm font-medium">
        <i class="fa-solid fa-circle-check text-domegold-400"></i>
        <span id="toastMessage">Bilgi</span>
    </div>

    <!-- =====================================================
         MAIN CONTENT AREA
         ===================================================== -->
    <main class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-8 flex-1">

        <!-- =================================================
             SECTION 1: KELİMELER (35 ESSENTIAL VOCABULARY WORDS)
             ================================================= -->
        <section id="tab-vocab" class="tab-panel space-y-6">
            <!-- Control Card -->
            <div class="bg-white rounded-2xl p-5 sm:p-6 border border-marble-200 shadow-sm space-y-4">
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                    <div>
                        <h2 class="font-display text-xl sm:text-2xl font-bold text-terracotta-800 flex items-center gap-2">
                            <i class="fa-solid fa-landmark text-domegold-500"></i> Ayasofya Rehberlik Kelime Hazinesi (35 Kelime)
                        </h2>
                        <p class="text-sm text-stone-600 mt-1">
                            Her kelimenin İngilizce seslendirmesini ve örnek rehber cümlesini dinleyebilir, IPA + Türkçe okunuşunu inceleyebilir ve öğrendiklerinizi işaretleyebilirsiniz.
                        </p>
                    </div>

                    <!-- Learned Progress Box -->
                    <div class="bg-marble-100 border border-marble-300 rounded-2xl px-4 py-3 min-w-[230px]">
                        <div class="flex items-center justify-between text-xs font-bold text-stone-700 mb-1.5">
                            <span>Öğrenme Durumu</span>
                            <span id="learnedCountText" class="text-terracotta-800">0 / 35 Öğrenildi</span>
                        </div>
                        <div class="w-full h-2.5 bg-marble-300 rounded-full overflow-hidden">
                            <div id="learnedProgressBar" class="h-full bg-emerald-600 transition-all duration-300" style="width: 0%"></div>
                        </div>
                    </div>
                </div>

                <!-- Search, Category Filters & Memorization Toggle -->
                <div class="pt-3 border-t border-marble-200 flex flex-col md:flex-row md:items-center justify-between gap-3">
                    <div class="flex flex-wrap items-center gap-1.5" id="vocabCatBtns">
                        <button onclick="setVocabCategory('all')" data-vcat="all" class="vcat-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-terracotta-700 text-white">Tümü (35)</button>
                        <button onclick="setVocabCategory('Mimari')" data-vcat="Mimari" class="vcat-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-marble-100 text-stone-700 hover:bg-marble-200">Mimari</button>
                        <button onclick="setVocabCategory('Tarih & Din')" data-vcat="Tarih & Din" class="vcat-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-marble-100 text-stone-700 hover:bg-marble-200">Tarih & Din</button>
                        <button onclick="setVocabCategory('Rehberlik & Tur')" data-vcat="Rehberlik & Tur" class="vcat-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-marble-100 text-stone-700 hover:bg-marble-200">Rehberlik & Tur</button>
                    </div>

                    <div class="flex flex-wrap items-center gap-2">
                        <div class="relative flex-1 sm:flex-initial">
                            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-stone-400 text-xs"></i>
                            <input type="text" id="vocabSearchInput" oninput="renderVocabulary()" placeholder="İngilizce veya Türkçe ara..." class="w-full sm:w-56 pl-8 pr-3 py-2 rounded-xl border border-marble-300 bg-marble-50 text-xs sm:text-sm focus:outline-none focus:border-domegold-500">
                        </div>
                        <button id="toggleHideMeaningsBtn" onclick="toggleVocabMemorizeMode()" class="px-3.5 py-2 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-950 font-bold text-xs transition flex items-center gap-1.5 border border-amber-300">
                            <i class="fa-solid fa-eye-slash"></i> Türkçe Anlamları Gizle (Ezber Modu)
                        </button>
                    </div>
                </div>
            </div>

            <!-- 35 Vocabulary Cards Grid -->
            <div id="vocabCardsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"></div>
        </section>

        <!-- =================================================
             SECTION 2: REHBERLİK KALIPLARI (18 GUIDING PATTERNS)
             ================================================= -->
        <section id="tab-phrases" class="tab-panel hidden space-y-6">
            <div class="bg-white rounded-2xl p-5 sm:p-6 border border-marble-200 shadow-sm space-y-4">
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                    <div>
                        <h2 class="font-display text-xl sm:text-2xl font-bold text-terracotta-800 flex items-center gap-2">
                            <i class="fa-solid fa-bullhorn text-domegold-500"></i> Pratik Turist Rehberliği Kalıpları (18 Kalıp)
                        </h2>
                        <p class="text-sm text-stone-600 mt-1">
                            Ayasofya turunun başından sonuna kadar kullanabileceğiniz doğal cümle kalıpları, okunuşları ve sahada işinize yarayacak rehberlik ipuçları.
                        </p>
                    </div>
                </div>

                <!-- 3 Category Filter Buttons -->
                <div class="flex flex-wrap gap-2 pt-2 border-t border-marble-200">
                    <button onclick="setPhraseCategory('all')" data-pcat="all" class="pcat-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-terracotta-700 text-white">
                        Tümü (18)
                    </button>
                    <button onclick="setPhraseCategory('welcome')" data-pcat="welcome" class="pcat-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-marble-100 text-stone-700 hover:bg-marble-200">
                        Karşılama & Kurallar (<span lang="en">Welcome & Rules</span>) (6)
                    </button>
                    <button onclick="setPhraseCategory('history')" data-pcat="history" class="pcat-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-marble-100 text-stone-700 hover:bg-marble-200">
                        Tarih & Mimari (<span lang="en">History & Architecture</span>) (6)
                    </button>
                    <button onclick="setPhraseCategory('directions')" data-pcat="directions" class="pcat-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-marble-100 text-stone-700 hover:bg-marble-200">
                        Yönlendirme & Serbest Zaman (<span lang="en">Directions & Free Time</span>) (6)
                    </button>
                </div>
            </div>

            <div id="phrasesListContainer" class="space-y-4"></div>
        </section>

        <!-- =================================================
             SECTION 3: OKUMA PARÇASI (READING PASSAGE + 5 QUESTIONS)
             ================================================= -->
        <section id="tab-reading" class="tab-panel hidden space-y-6">
            <div class="bg-white rounded-2xl p-5 sm:p-7 border border-marble-200 shadow-sm">
                <!-- Reading Header & Toggles -->
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-5 border-b border-marble-200">
                    <div>
                        <span class="text-xs font-bold text-domegold-600 tracking-wider" lang="en">READING PASSAGE • PRE-INTERMEDIATE / INTERMEDIATE</span>
                        <h2 class="font-display text-2xl sm:text-3xl font-bold text-terracotta-800 mt-1" lang="en">
                            Hagia Sophia: The Monument of Holy Wisdom
                        </h2>
                        <p class="text-xs sm:text-sm text-stone-600 mt-1">
                            <i class="fa-solid fa-hand-pointer text-domegold-600"></i> Metin içindeki <strong>altı çizili kelimelere tıklayarak</strong> anlam ve okunuş kartını açabilirsiniz.
                        </p>
                    </div>

                    <div class="flex flex-wrap items-center gap-2 shrink-0">
                        <button id="playAllReadingBtn" onclick="togglePlayAllReading()" class="px-4 py-2.5 rounded-xl bg-terracotta-700 hover:bg-terracotta-800 text-white font-bold text-xs sm:text-sm shadow-sm transition flex items-center gap-2">
                            <i class="fa-solid fa-play"></i> Tüm Metni Dinle (<span lang="en">Play All</span>)
                        </button>
                        <button id="toggleReadingPronBtn" onclick="toggleReadingPronunciation()" class="px-3.5 py-2.5 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-950 border border-amber-300 font-bold text-xs sm:text-sm transition">
                            🗣️ Okunuş Rehberini Gizle
                        </button>
                        <button id="toggleReadingTransBtn" onclick="toggleReadingTranslations()" class="px-3.5 py-2.5 rounded-xl bg-marble-100 hover:bg-marble-200 text-stone-800 border border-marble-300 font-bold text-xs sm:text-sm transition">
                            🇹🇷 Türkçe Çeviriyi Göster
                        </button>
                    </div>
                </div>

                <!-- Clickable Word Popup Banner -->
                <div id="inlineVocabPopup" class="hidden mt-4 p-4 rounded-2xl bg-amber-50 border-2 border-domegold-400 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-sm">
                    <div class="space-y-1">
                        <div class="flex flex-wrap items-center gap-2">
                            <span id="popupVocabWord" class="font-display font-bold text-lg text-terracotta-800" lang="en"></span>
                            <span id="popupVocabPron" class="text-xs px-2.5 py-0.5 rounded-lg bg-white border border-amber-300 text-amber-950 font-semibold"></span>
                        </div>
                        <p id="popupVocabMeaning" class="text-sm font-bold text-stone-800"></p>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <button id="popupVocabSpeakBtn" class="px-3.5 py-2 rounded-xl bg-terracotta-700 hover:bg-terracotta-800 text-white text-xs font-bold flex items-center gap-1.5">
                            <i class="fa-solid fa-volume-high"></i> Kelimeyi Dinle
                        </button>
                        <button onclick="document.getElementById('inlineVocabPopup').classList.add('hidden')" class="w-8 h-8 rounded-lg bg-white border border-amber-200 text-stone-500 hover:text-stone-800 flex items-center justify-center">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>

                <!-- 5 Paragraphs Container -->
                <div id="readingParagraphsBox" class="mt-6 space-y-5"></div>
            </div>

            <!-- 5 Reading Comprehension Questions -->
            <div class="bg-white rounded-2xl p-5 sm:p-7 border border-marble-200 shadow-sm">
                <h3 class="font-display text-lg sm:text-xl font-bold text-terracotta-800 mb-4 flex items-center gap-2">
                    <i class="fa-solid fa-circle-question text-domegold-500"></i> Okuduğunu Anlama Soruları (<span lang="en">5 Reading Comprehension Questions</span>)
                </h3>
                <div id="readingCompGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
            </div>
        </section>

        <!-- =================================================
             SECTION 4: TURİST - REHBER DİYALOĞU (14 LINES)
             ================================================= -->
        <section id="tab-dialogue" class="tab-panel hidden space-y-6">
            <div class="bg-white rounded-2xl p-5 sm:p-7 border border-marble-200 shadow-sm">
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-5 border-b border-marble-200">
                    <div>
                        <span class="text-xs font-bold text-domegold-600 tracking-wider" lang="en">REALISTIC GUIDED TOUR DIALOGUE • 14 LINES</span>
                        <h2 class="font-display text-xl sm:text-2xl font-bold text-terracotta-800 mt-1" lang="en">
                            A Guided Tour Inside Hagia Sophia
                        </h2>
                        <p class="text-sm text-stone-600 mt-1">
                            <strong>Rehber Kerem</strong>, <strong>Sarah</strong> (İngiltere) ve <strong>Marco</strong> (İtalya) arasında Sultanahmet Meydanı'ndan Ayasofya'nın içine uzanan gerçekçi tur diyaloğu.
                        </p>
